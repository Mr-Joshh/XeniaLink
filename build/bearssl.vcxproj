<?xml version="1.0" encoding="utf-8"?>
<!-- BearSSL (third_party/bearssl) as a static library for the plugin's HTTPS client.
     Built by build.bat before XeniaLink.vcxproj; only the objects the plugin uses get linked. -->
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Xbox 360">
      <Configuration>Debug</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Xbox 360">
      <Configuration>Release</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectName>bearssl</ProjectName>
    <ProjectGuid>{6E1F3A52-9C4B-4E0A-8D3B-58411294A002}</ProjectGuid>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\bearssl\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <CompileAs>CompileAsC</CompileAs>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <!-- MinSpace was tried: .text shrinks ~9 KB, but the image (sections on 64 KB
           boundaries) stays 0x50000, so there's no memory gain. Keep speed. -->
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <AdditionalIncludeDirectories>..\third_party\bearssl\src;..\third_party\bearssl\inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- MSVC 2010's C compiler has no 'inline'. No OS randomness or clock on the console:
           tls.cpp injects XeCryptRandom entropy and sets the time itself. -->
      <PreprocessorDefinitions>_XBOX;XBOX;inline=__inline;BR_USE_WIN32_RAND=0;BR_USE_WIN32_TIME=0;BR_USE_URANDOM=0;BR_USE_GETENTROPY=0;BR_USE_UNIX_TIME=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\third_party\bearssl\src\**\*.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
