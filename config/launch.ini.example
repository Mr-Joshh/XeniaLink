; Add XeniaLink to your existing DashLaunch launch.ini (Hdd:\launch.ini or Usb:\launch.ini).
; Use any free pluginN slot and keep your other plugins (xbdm etc.) as they are.
; The path just has to match where you copied XeniaLink.xex.

[Plugins]
plugin1 = Hdd:\Xbdm.xex
plugin2 = Hdd:\XeniaLink.xex

; Keep DashLaunch's Live protection on. XeniaLink never needs real Xbox Live.
[Settings]
liveblock = true
livestrong = true
